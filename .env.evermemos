# EverMemOS 環境變數
# 使用 host.docker.internal 連接到主機的 Docker 網路

LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=EMPTY

VECTORIZE_PROVIDER=vllm
VECTORIZE_BASE_URL=http://host.docker.internal:11434/v1
VECTORIZE_MODEL=qwen3-embedding:latest
VECTORIZE_API_KEY=EMPTY

REDIS_HOST=host.docker.internal
MONGODB_HOST=host.docker.internal
ES_HOSTS=http://host.docker.internal:19200
MILVUS_HOST=host.docker.internal
