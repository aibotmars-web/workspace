def call_ai(prompt: str, timeout: int = 120, max_retries: int = 3) -> str | None:
    """透過 openclaw agent 呼叫 MiniMax AI（含自動重試）"""
    import time as _time
    for attempt in range(1, max_retries + 1):
        try:
            result = subprocess.run(
                ["openclaw", "agent", "--agent", "main", "--json", "--message", prompt],
                capture_output=True, text=True, timeout=timeout
            )
            raw = result.stdout or ""
            # ★ 跳過 plugin/log 前綴行（如 [plugins] ...），定位 JSON 起始
            json_start = raw.find('{')
            if json_start < 0:
                if result.stderr:
                    print(f"   ⚠️ openclaw stderr: {result.stderr[:200]}")
                if attempt < max_retries:
                    print(f"   ⚠️ MiniMax 回應無 JSON，{3}秒後重試 ({attempt}/{max_retries})...")
                    _time.sleep(3)
                continue
            data = json.loads(raw[json_start:])
            payloads = data.get("result", {}).get("payloads", [])
            if payloads and payloads[0].get("text"):
                return payloads[0]["text"]
            status = data.get("status", "unknown")
            if attempt < max_retries:
                print(f"   ⚠️ MiniMax 回應無 payload (status={status})，{3}秒後重試 ({attempt}/{max_retries})...")
                _time.sleep(3)
        except subprocess.TimeoutExpired:
            print(f"   ⚠️ AI 呼叫逾時 ({attempt}/{max_retries})")
            if attempt < max_retries:
                _time.sleep(2)
        except json.JSONDecodeError as e:
            print(f"   ⚠️ MiniMax JSON 解析錯誤：{e}，前100字：{raw[:100]}")
            if attempt < max_retries:
                _time.sleep(3)
        except Exception as e:
            print(f"   ⚠️ AI 呼叫失敗：{e}")
            break
    return None


